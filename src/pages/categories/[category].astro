---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { siteConfig } from '../../config'
import { getCollection } from 'astro:content'
import PostList from '../../components/PostList.astro'
import Pagination from '../../components/Pagination.astro'
import { sortPosts, slicePage, pageCount } from '../../lib/posts'

export async function getStaticPaths() {
  const allPosts = await getCollection('posts')
  const categories = [
    ...new Set(allPosts.map((p) => p.data.category).filter(Boolean))
  ]
  return categories.map((cat) => ({
    params: { category: cat },
    props: {
      category: cat,
      posts: sortPosts(allPosts.filter((p) => p.data.category === cat))
    }
  }))
}

const { category, posts } = Astro.props
const hrefFor = (n: number) =>
  n === 1
    ? `/categories/${encodeURIComponent(category)}`
    : `/categories/${encodeURIComponent(category)}/${n}`
---

<BaseLayout title={`${category} - ${siteConfig.title}`}>
  <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <h1 style="font-size:1.3em;">{category}</h1>
    <span style="color:var(--text-muted); font-size:13px;"
      >{posts.length} 篇</span
    >
  </div>
  <PostList posts={slicePage(posts, 1)} />
  <Pagination
    currentPage={1}
    totalPages={pageCount(posts.length)}
    {hrefFor}
  />
</BaseLayout>
